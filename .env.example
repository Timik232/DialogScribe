# Mistral API configuration
MISTRAL_API_KEY=your_mistral_api_key_here
ASR_URL=https://api.mistral.ai
ASR_MODEL=voxtral-mini-latest

# LiteLLM ASR Provider
LITELLM_API_KEY=sk-1234
LITELLM_URL=https://litellm.komolov.synology.me
LITELLM_MODEL=gigaamv3-generation

# HuggingFace token (required for diarization)
HF_TOKEN=your_huggingface_token_here

# Environment mode: "production" (default) or "development".
# production: API docs/schema disabled; startup ABORTS when secrets are
#   missing/weak (JWT_SECRET <32 chars; API_KEY missing/weak/equal to
#   JWT_SECRET when V1_API_ENABLED=true).
# development: docs enabled; the same secret problems only log warnings.
ENVIRONMENT=production

# --- Application secrets (independent, never reuse one for the other) ------
# JWT_SECRET signs login/session tokens. Required in production.
# Generate a strong value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<generate-with-python-secrets-token-urlsafe-48>

# API_KEY: bearer key for the OpenAI-compatible /v1 API. Required only when
# V1_API_ENABLED=true; must be >=32 chars and DIFFERENT from JWT_SECRET.
# Generate the same way as JWT_SECRET.
API_KEY=

# V1_API_ENABLED: expose /v1/audio/transcriptions? "false" (default) makes
# every /v1 route return 503 without processing; "true" requires API_KEY
# (missing key config -> 503, wrong/absent bearer -> 401, correct -> 200).
V1_API_ENABLED=false

# Optional: Max upload size in MB. Must match the single aligned default
# shared by the backend (routers/_uploads.py), docker-compose*.yaml, the
# frontend uploader and the README.
MAX_UPLOAD_SIZE_MB=1024

# Gradio Web UI Authentication (leave empty to disable auth)
GRADIO_USERNAME=
GRADIO_PASSWORD=

# LLM configuration (for summary/mindmap via OpenAI-compatible API, e.g. LiteLLM)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1
LLM_MODELS=gpt-4.1,gpt-4o-mini
LLM_API_KEY=your_litellm_api_key_here
