# Mistral API configuration
MISTRAL_API_KEY=your_mistral_api_key_here
ASR_URL=https://api.mistral.ai
ASR_MODEL=voxtral-mini-latest

# HuggingFace token (required for diarization)
HF_TOKEN=your_huggingface_token_here

# Optional: Bearer token for API auth. Leave empty to disable auth.
API_KEY=your-api-key-here

# Optional: Max upload size in MB (default: 100)
MAX_UPLOAD_SIZE_MB=100

# Gradio Web UI Authentication (leave empty to disable auth)
GRADIO_USERNAME=
GRADIO_PASSWORD=

# LLM configuration (for summary/mindmap via OpenAI-compatible API, e.g. LiteLLM)
LLM_BASE_URL=https://litellm.komolov.synology.me/v1
LLM_MODEL=gpt-4.1
LLM_MODELS=gpt-4.1,gpt-4o-mini
LLM_API_KEY=your_litellm_api_key_here
